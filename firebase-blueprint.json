{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and private profile data for authenticated users",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Email address of user",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "GenerationItem": {
      "title": "GenerationItem",
      "description": "AI created asset record (video, image, audio, or music)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique record identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Type of AI generation",
          "enum": [
            "text-to-video",
            "image-to-video",
            "image-create",
            "image-edit",
            "audio-transcribe",
            "music-generate"
          ]
        },
        "prompt": {
          "type": "string",
          "description": "User text prompt or audio source description",
          "maxLength": 4096
        },
        "model": {
          "type": "string",
          "description": "AI Model name used",
          "maxLength": 128
        },
        "mediaUrl": {
          "type": "string",
          "description": "Generated or uploaded media preview URL",
          "maxLength": 2048
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio (16:9, 9:16, 1:1, etc.)",
          "maxLength": 32
        },
        "resultData": {
          "type": "string",
          "description": "Transcription text, music lyrics, or description",
          "maxLength": 32768
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Generation timestamp"
        }
      },
      "required": ["id", "userId", "type"]
    },
    "WatermarkHistoryItem": {
      "title": "WatermarkHistoryItem",
      "description": "Watermark removal job history document",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Record ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mediaId": {
          "type": "string",
          "description": "Media asset identifier",
          "maxLength": 128
        },
        "filename": {
          "type": "string",
          "description": "Original file name",
          "maxLength": 256
        },
        "isVideo": {
          "type": "boolean",
          "description": "Whether media is video"
        },
        "resolution": {
          "type": "string",
          "description": "Asset resolution",
          "maxLength": 64
        },
        "format": {
          "type": "string",
          "description": "File format",
          "maxLength": 32
        },
        "fileSize": {
          "type": "number",
          "description": "File size in bytes"
        },
        "originalMediaUrl": {
          "type": "string",
          "description": "URL to original file",
          "maxLength": 2048
        },
        "cleanMediaUrl": {
          "type": "string",
          "description": "URL to cleaned media",
          "maxLength": 2048
        },
        "downloadUrl": {
          "type": "string",
          "description": "Direct download URL",
          "maxLength": 2048
        },
        "regionsCount": {
          "type": "number",
          "description": "Number of watermark regions processed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Processing completion timestamp"
        }
      },
      "required": ["id", "userId", "filename"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by auth UID"
    },
    "/users/{userId}/generations/{generationId}": {
      "schema": "GenerationItem",
      "description": "AI generation records (video, image, audio transcription, music) for the user"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "WatermarkHistoryItem",
      "description": "Watermark removal history records for the user"
    }
  }
}
