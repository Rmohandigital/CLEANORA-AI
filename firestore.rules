rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId is string &&
        data.email is string &&
        data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    // AI Generation Document Validation
    function isValidGeneration(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.type is string &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 4096)) &&
        (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2048)) &&
        (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 32)) &&
        (!('resultData' in data) || (data.resultData is string && data.resultData.size() <= 32768));
    }

    // Watermark History Document Validation
    function isValidWatermarkHistory(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.filename is string && data.filename.size() <= 256 &&
        (!('mediaId' in data) || (data.mediaId is string && data.mediaId.size() <= 128)) &&
        (!('isVideo' in data) || data.isVideo is bool) &&
        (!('regionsCount' in data) || data.regionsCount is number);
    }

    // ==========================================
    // Users Collection & Subcollections
    // ==========================================
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // AI Generations Subcollection (Veo Video, Image, Audio, Music)
      match /generations/{generationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(generationId) && isValidGeneration(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(generationId) && isValidGeneration(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Watermark History Subcollection
      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(historyId) && isValidWatermarkHistory(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(historyId) && isValidWatermarkHistory(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
